{
  "name": "eclipse-arena-api",
  "version": "1.0.0",
  "private": true,
  "description": "Eclipse Arena API server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "mkdir -p dist && cp index.html script.js match-3d.js style.css fought-knight.css config.js dist/",
    "check": "node --check server.js && node --check script.js && node --check match-3d.js && node --check config.js",
    "test": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.4"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "path-to-regexp": "0.1.13",
    "qs": "^6.17.1",
    "engine.io": "^6.6.10",
    "socket.io-parser": "^4.2.6",
    "ws": "^8.21.0",
    "proxy-addr": "^2.0.8"
  }
}
